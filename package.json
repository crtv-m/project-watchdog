{
  "name": "project-watchdog",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "tsc",
    "start": "npm run db:generate && npm run db:push && npm run build && exec node scripts/start.mjs",
    "dev:api": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "start:api": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "pm2:start": "pm2 start ecosystem.config.cjs"
  },
  "dependencies": {
    "@fastify/static": "^8.2.0",
    "fastify": "^5.4.0",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "@prisma/client": "^6.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "prisma": "^6.7.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
